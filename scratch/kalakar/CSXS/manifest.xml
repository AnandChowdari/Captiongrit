<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
Version="6.0"
ExtensionBundleId="com.kalakar"
ExtensionBundleVersion="1.1.0"
ExtensionBundleName="Kalakar"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
<ExtensionList>
  <Extension Id="com.kalakar.main" Version="1.1.0" />
</ExtensionList>
<ExecutionEnvironment>
  <HostList>
    <Host Name="PPRO" Version="[22.0,99.9]" />
  </HostList>
  <LocaleList>
    <Locale Code="All" />
  </LocaleList>
  <RequiredRuntimeList>
    <RequiredRuntime Name="CSXS" Version="11.0" />
  </RequiredRuntimeList>
</ExecutionEnvironment>
<DispatchInfoList>
  <Extension Id="com.kalakar.main">
    <DispatchInfo>
      <Resources>
        <MainPath>./main/index.html</MainPath>
        <CEFCommandLine>
          <Parameter>--v=0</Parameter>
          <Parameter>--enable-nodejs</Parameter>
          <Parameter>--mixed-context</Parameter>
        </CEFCommandLine>
      </Resources>
      <Lifecycle>
        <AutoVisible>true</AutoVisible>
      </Lifecycle>
      <UI>
        <Type>Panel</Type>
        <Menu>Kalakar</Menu>
        <Geometry>
          <Size>
            <Width>600</Width>
            <Height>650</Height>
          </Size>
        </Geometry>
        <Icons>
          <Icon Type="Normal">./js/favicon.ico</Icon>
          <Icon Type="DarkNormal">./js/favicon.ico</Icon>
          <Icon Type="RollOver">./js/favicon.ico</Icon>
          <Icon Type="DarkRollOver">./js/favicon.ico</Icon>
        </Icons>
      </UI>
    </DispatchInfo>
  </Extension>
</DispatchInfoList>
</ExtensionManifest>